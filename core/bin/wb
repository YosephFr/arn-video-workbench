#!/usr/bin/env bash
# Workbench CLI. Uses the repo's .venv when present, otherwise python3 from PATH (needs numpy) and ffmpeg.
# Loads KEY=VALUE lines from the repo's .env (unless WB_NO_DOTENV is set). Variables already in the environment,
# even empty ones, always win, and empty values in .env are skipped, so a copied .env.example never blanks a key.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PY="python3"
[ -x "$ROOT/.venv/bin/python" ] && PY="$ROOT/.venv/bin/python"

load_dotenv() {
  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"                     # leading blanks
    case "$line" in ''|'#'*) continue ;; esac
    line="${line#export }"
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    if [[ "$value" =~ ^\"([^\"]*)\"([[:space:]].*)?$ ]] || [[ "$value" =~ ^\'([^\']*)\'([[:space:]].*)?$ ]]; then
      value="${BASH_REMATCH[1]}"                                # quoted: taken literally
    else
      case "$value" in '#'*) value='' ;; esac                   # KEY=   # only a comment
      value="${value%%[[:space:]]#*}"                           # an inline comment
      value="${value%"${value##*[![:space:]]}"}"                # trailing blanks
    fi
    [[ "$value" == "~/"* ]] && value="$HOME/${value#"~/"}"
    [ -n "$value" ] || continue                                 # empty: never blank a variable
    [ -n "${!key+set}" ] && continue                            # already in the environment: it wins
    export "$key=$value"
  done < "$1"
}

if [ -f "$ROOT/.env" ] && [ -z "${WB_NO_DOTENV:-}" ]; then
  load_dotenv "$ROOT/.env"
fi
export PYTHONPATH="$ROOT/core/python${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m workbench.cli "$@"
