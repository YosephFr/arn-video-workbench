# Copy to .env (git-ignored) and uncomment what you need. Every value is optional: without keys, use
# WB_TTS_PROVIDER=silent and the samples still render.
#
# core/bin/wb loads this file by itself. A variable already set in your shell wins over .env, and empty values are
# skipped, so a copied .env never blanks a key you exported. The bench engines and tools (node .../render.mjs,
# bin/studio, the Python tools) read only the shell environment: load .env into the shell first with
#   set -a; . ./.env; set +a

# --- Voice and music providers
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=                 # optional audio judge in progress-report-video
# WB_TTS_PROVIDER=silent          # force one provider for a run: elevenlabs | openai | cosyvoice | say | silent

# --- Voice ids used by the sample scripts ("voice": "${WB_VOICE_NARRATOR}")
# WB_VOICE_NARRATOR=
# WB_VOICE_GUEST=
# WB_VOICE_CUSTOMER=
# WB_VOICE_OWNER=
# WB_VOICE_HOST=                  # two-character-studio
# WB_VOICE_ORB=

# --- Local CosyVoice (core/bin/install-cosyvoice.sh)
# COSYVOICE_HOME=~/.local/share/cosyvoice
# COSYVOICE_CLI=
# COSYVOICE_MODEL=
# COSYVOICE_FRONTEND=
# WB_WHISPER_MODEL=medium         # local faster-whisper model for word timings
# WB_LANGUAGE=en                  # language of the local word timings (default: script.json "language")

# --- Model overrides for transcription and judges
# WB_TRANSCRIBE_MODEL=whisper-1   # OpenAI transcription for word timings; it must return word timestamps
# WB_JUDGE_OPENAI_MODEL=gpt-audio-1.5
# WB_JUDGE_GEMINI_MODEL=gemini-2.5-flash

# --- Paths
# WB_FONTS_DIR=assets/fonts
# WB_STIPPLE_CACHE=
# WB_CAPTURES=                    # extra capture folders, separated by ":"
# WB_PLAYWRIGHT_FROM=             # a package.json whose node_modules has Playwright, for tools/capture.mjs

# --- Switches for a single run: set them on the command line (WB_GUIDES=social node ...), not here
# WB_NO_DOTENV=1                  # in the shell: core/bin/wb skips this file
# WB_GUIDES=social                # draw platform safe zones on stills
# WB_COVER='Title|Subtitle'       # app-tutorial: a still becomes a grid cover with a title band
# WB_REEL=1                       # story-highlights: a story without the pack header, for the reel
# WB_ACTS=hook,cost               # particle-film: render only these acts
# WB_CAPTIONS=0                   # particle-film and micro-ad-series: hide captions
# WB_DEBUG=1                      # stack traces

# --- two-character-studio
# WB_GL=auto                      # auto | gpu | swiftshader (software WebGL)
# WB_PYTHON=                      # Python with numpy + Pillow for the studio tools
# HDR_PRESET=plus
# X265_PRESET=
# X265_CRF=
# VT_BITRATE=
