{
  "name": "micro-ad-series",
  "version": "1.0.0",
  "private": true,
  "description": "A series of short single-message vertical ads from one shared workshop (runs on the particle-film engine).",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "npm --prefix ../particle-film install",
    "catalogue": "node tools/catalogue.mjs",
    "lint": "node tools/lint-script.mjs episodes/001-first-episode",
    "still": "node engine/render.mjs episodes/001-first-episode still 0.8,2.5,4.5,6.5,9,12,14",
    "preview": "node engine/render.mjs episodes/001-first-episode preview",
    "final": "node engine/render.mjs episodes/001-first-episode final",
    "poster": "node engine/render.mjs episodes/001-first-episode poster --out docs/poster.png"
  }
}
